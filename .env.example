# Copy to .env.local and fill in. Never commit real values.

# --- Contentstack (delivery, read-only) -------------------------------------
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_PREVIEW_TOKEN=
CONTENTSTACK_ENVIRONMENT=preview      # the environment the delivery token is bound to
CONTENTSTACK_REGION=eu                # us | eu | au | azure-na | azure-eu | gcp-na

# --- Contentstack (management; seeding scripts only, never used by the storefront) ---
CONTENTSTACK_MANAGEMENT_TOKEN=

# --- BigCommerce (Storefront GraphQL, channel-scoped token) -----------------
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CHANNEL_ID=
BIGCOMMERCE_STOREFRONT_TOKEN=         # created per origin (http://localhost:3000, production domain)

# --- Optional -----------------------------------------------------------------
# CONTENTSTACK_EDIT_MODE=true         # load Visual Editor tooling outside local development
